{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trinetra",
  "version": "0.2.0",
  "identifier": "org.trinetra.assistive.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Trinetra — Assistive Vision & Navigation",
        "width": 960,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:8000; img-src 'self' blob: data: http://127.0.0.1:8000; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/trinetra-vision-engine"
    ],
    "resources": [
      "binaries/_internal/**/*"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDREQkVCRDkyODkzNzg2NjEKUlVTMXkyM0R3V3FZZGNYbkZIdlhkZ3JzN3dJUlM2UDRpVGhkc0R6a0dTR1RrbG1ocW9hMytZc2EK",
      "endpoints": [
        "https://github.com/taksyastudio-gif/trinetra-releases/releases/latest/download/latest.json"
      ]
    }
  }
}
