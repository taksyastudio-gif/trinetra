# Track lightweight ONNX production models and metadata
!services/vision-engine/models/signs/v1/*.onnx
!services/vision-engine/models/signs/v1/*.json
!services/vision-engine/models/vehicles/v1/*.onnx
!services/vision-engine/models/vehicles/v1/*.json

# Local POC, experimental tests, and binary runtimes
test_piper_poc/
services/vision-engine/runtime/*
