# Trinetra Vision Engine Configuration (.env.example)
# Copy this file to .env for custom local development overrides.
# In production, the Tauri desktop supervisor manages tokens and process lifecycles automatically.

# Server Binding (Strictly loopback for local-first zero-cloud privacy)
TRINETRA_HOST=127.0.0.1
TRINETRA_PORT=8000

# Authentication
# In production, Tauri generates a cryptographically secure 256-bit ephemeral token via BCryptGenRandom.
# For standalone API testing without Tauri, set a custom token here:
TRINETRA_SESSION_TOKEN=

# Camera Hardware Configuration
# 0 = Default USB webcam via Windows DirectShow
# String URL = Network stream (e.g., ESP32-CAM MJPEG stream)
TRINETRA_CAMERA_SOURCE=0
# Example for ESP32-CAM:
# TRINETRA_CAMERA_SOURCE=http://192.168.1.100:81/stream

# Piper Neural Text-To-Speech Configuration
# By default, paths resolve relative to services/vision-engine/
# Set TRINETRA_DISABLE_PIPER=1 to force Windows SAPI5 fallback
TRINETRA_DISABLE_PIPER=0
TRINETRA_PIPER_EXE=
TRINETRA_PIPER_MODEL=
TRINETRA_PIPER_CONFIG=
TRINETRA_PIPER_HAZARD_WAV=

# Incident Telemetry and Snapshot Storage
# Defaults to services/vision-engine/incidents/
TRINETRA_INCIDENTS_DIR=
